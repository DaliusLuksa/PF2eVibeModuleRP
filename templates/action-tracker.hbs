<section class="vibe-action-tracker">
    {{#if active}}
    {{#if disabled}}
    <div class="at-enemy at-disable">
        <i class="fa-solid fa-ban"></i>
        <span>{{@root.i18n 'disabled'}}</span>
        {{#if isGM}}
        <button type="button" class="at-enable" data-action="toggleDisable" data-tooltip="{{@root.i18n 'disableTooltip'}}">{{@root.i18n 'enable'}}</button>
        {{/if}}
    </div>
    {{else if hidden}}
    <div class="at-enemy">
        <i class="fa-solid fa-hood-cloak"></i>
        <span>{{@root.i18n 'enemyTurn'}}</span>
    </div>
    {{else}}
    <header class="at-header">
        {{#if combatantImg}}<img class="at-portrait" src="{{combatantImg}}" alt="{{combatantName}}">{{/if}}
        <div class="at-meta">
            <h3 class="at-name">{{combatantName}}</h3>
            <span class="at-round">{{@root.i18n 'round'}} {{round}}</span>
        </div>
    </header>

    <ol class="at-log">
        {{#each entries}}
        <li class="at-entry {{#if warpMove}}at-warp{{/if}}">
            <span class="at-cost">{{cost}}</span>
            {{#if icon.img}}<img class="at-icon at-icon-img" src="{{icon.img}}" alt="" data-tooltip="{{#if warpMove}}{{@root.i18n 'warpFree'}}{{else}}{{cost}} {{@root.i18n 'actions'}}{{/if}}">{{else}}<i class="at-icon fa-solid {{icon.fa}}" data-tooltip="{{#if warpMove}}{{@root.i18n 'warpFree'}}{{else}}{{cost}} {{@root.i18n 'actions'}}{{/if}}"></i>{{/if}}
            <span class="at-name">{{name}}</span>
        </li>
        {{else}}
        <li class="at-empty">{{@root.i18n 'empty'}}</li>
        {{/each}}
    </ol>

    <footer class="at-footer">
        <div class="at-meter">
            <span class="at-used">{{used}}</span>
            <span class="at-sep">/</span>
            <span class="at-max">{{max}}</span>
        </div>
        <div class="at-remaining">{{@root.i18n 'remaining'}} {{remaining}}</div>
        {{#if isGM}}
        <div class="at-controls">
            <button type="button" data-action="spend" data-cost="1" data-tooltip="{{@root.i18n 'manual'}}">+1</button>
            <button type="button" data-action="reaction" data-tooltip="{{@root.i18n 'reaction'}}">R</button>
            <button type="button" data-action="undo" data-tooltip="{{@root.i18n 'undo'}}"><i class="fa-solid fa-rotate-left"></i></button>
            <button type="button" data-action="toggleHideAll" data-tooltip="{{@root.i18n 'hideAll'}}" class="{{#if hideAll}}on{{/if}}"><i class="fa-solid fa-eye-slash"></i></button>
            <button type="button" data-action="toggleDisable" data-tooltip="{{@root.i18n 'disableTooltip'}}" class="{{#if disabled}}on{{/if}}"><i class="fa-solid fa-ban"></i></button>
        </div>
        {{/if}}
    </footer>
    {{/if}}
    {{else}}
    <p class="at-inactive">{{@root.i18n 'inactive'}}</p>
    {{/if}}
</section>