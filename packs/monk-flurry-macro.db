{"_id":"MnkFlurry0000001","name":"Flurry of Blows - Monk","type":"script","img":"systems/pf2e/icons/features/classes/flurry-of-blows.webp","command":"// Flurry of Blows - Monk\n// Requires: controlled monk token + one target\n// Calls the VibeModuleRP automation (MAP, combined damage, Stunning Blows with incapacitation, Wolf Stance trips)\nconst mod = game.modules.get(\"pf2e-vibemodulerp\");\nif (!mod?.api?.monkFlurry) {\n  ui.notifications.error(\"Monk Flurry tool not ready - reload world and ensure the module is enabled\");\n} else {\n  await mod.api.monkFlurry();\n}","folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"pf2e","systemVersion":"8.4.0","coreVersion":"14.365"},"scope":"global"}
